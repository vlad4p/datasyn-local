# datasyn-local — copy to .env and fill in values (never commit .env)

# DuckDB and paths (optional overrides)
# DATASYN_DB_PATH=data/duckdb/datasyn.duckdb
# DATASYN_LANDING_PATH=data/landing
# DATASYN_REPORTS_PATH=reports

# SociaVault API — https://docs.sociavault.com
# Get your key from https://sociavault.com/dashboard
SOCIAVAULT_API_KEY=sk_live_your_api_key_here

# LLM classification (DeepSeek by default) — used by classify_sv_comments.py
# Get your key from https://platform.deepseek.com/api_keys
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...   # optional alias for LLM_API_KEY
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
#
# OpenAI instead: LLM_PROVIDER=openai LLM_MODEL=gpt-4o-mini LLM_BASE_URL=https://api.openai.com/v1
