# datasyn-local — copy to .env and fill in values (never commit .env)

# DuckDB and paths (optional overrides)
# DATASYN_DB_PATH=data/duckdb/datasyn.duckdb
# DATASYN_LANDING_PATH=data/landing
# DATASYN_REPORTS_PATH=reports

# SociaVault API — https://docs.sociavault.com
# Get your key from https://sociavault.com/dashboard
SOCIAVAULT_API_KEY=sk_live_your_api_key_here

# LLM classification (DeepSeek by default) — used by classify_sv_comments.py
# Get your key from https://platform.deepseek.com/api_keys
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...   # optional alias for LLM_API_KEY
LLM_MODEL=deepseek-chat
# CHAT_MODEL=deepseek-chat   # optional alias preferred by classify_tk_tw_replies.py
LLM_BASE_URL=https://api.deepseek.com
#
# OpenAI instead: LLM_PROVIDER=openai LLM_MODEL=gpt-4o-mini LLM_BASE_URL=https://api.openai.com/v1

# Twikit (X/Twitter session scrape) — https://twikit.readthedocs.io/en/latest/twikit.html
# Never commit .env or cookies. Cookies default: .data/twikit_cookies.json
# TWITTER_USERNAME=your_handle_or_phone
# TWITTER_EMAIL=optional@email.com
# TWITTER_PASSWORD=your_password
# TWITTER_TOTP_SECRET=   # optional 2FA
# TWITTER_COOKIES_PATH=.data/twikit_cookies.json

# --- Quack client (ATTACH to remote warehouse, e.g. datasyn-duckdb fleet) ---
# Attach via: ATTACH 'quack:HOST:PORT' AS "datasyn-rlab" (TYPE quack, TOKEN '…', DISABLE_SSL true);
# Align QUACK_TOKEN with the warehouse you attach to (never commit the real token).
QUACK_HOST=10.13.10.119
QUACK_PORT=9494
QUACK_TOKEN=
QUACK_DISABLE_SSL=true

# --- Quack host (serve THIS repo's datasyn.duckdb over HTTP) ---
# Start: uv run python scripts/python/db.py quack-host
# Default bind is localhost:9495 (avoids fleet :9494). For LAN:
#   QUACK_BIND_URI=quack:0.0.0.0:9494
#   QUACK_ALLOW_OTHER_HOSTNAME=true
# QUACK_BIND_URI=quack:127.0.0.1:9495
# QUACK_ALLOW_OTHER_HOSTNAME=false
# Clients of a local host: set QUACK_HOST=127.0.0.1 QUACK_PORT=9495 (+ same QUACK_TOKEN).
