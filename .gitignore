# Python / uv
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
dist/
build/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Environment (never commit secrets)
.env
.env.local
.env.*.local

# Alternate local data directory (outside data/)
.data/
.data/**

# DuckDB databases and sidecar files
data/duckdb/**
!data/duckdb/.gitkeep
!data/duckdb/README.md
*.duckdb
*.db
*.wal
*.tmp
*.duckdb.wal
*.sqlite
*.sqlite3

# Landing zone — raw downloads, scrapes, exports (keep structure only)
data/landing/**
!data/landing/.gitkeep
!data/landing/README.md

# Generated reports and outputs
report/**
!report/.gitkeep
!report/README.md
reports/**
output/
exports/
downloads/
tmp/
scratch/

# Local data artifacts (outside landing/duckdb)
*.parquet
*.feather
*.arrow

# Data files at repo root (never commit datasets here)
/*.csv
/*.tsv
/*.json
/*.xlsx
/*.parquet

# Scraped / cached HTML snapshots
*.html.gz
.cache/

# Credentials, tokens, sessions (never commit)
*.pem
*.key
*.p12
credentials.json
secrets.yaml
secrets.json
*credentials*
cookies.txt
*.session
*.token

# IDE / OS
.idea/
.vscode/mcp.json
*.swp
*.swo
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Cursor (local IDE config — bootstrap writes mcp.json)
.cursor/
kilo.json

# Logs and backups
*.log
.logs/
*.bak
*.backup

# Lock file (local resolution — do not commit)
uv.lock
